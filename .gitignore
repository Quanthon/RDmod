# Godot 4+ specific ignores
.godot/
/android/

# Locally cloned third-party documentation repositories
/docs/references/

# Locally decompiled official game code. Do not commit proprietary game sources.
/OfficialReference/SlayTheSpire2/
/OfficialReference/generated/
/OfficialReference/localization/

# Local third-party tools and runtimes (for example STS2-Agent).
/.tools/

# Python bytecode caches generated by local tooling.
__pycache__/
*.py[cod]

# Local artwork sync reports and original-file backups
/outputs/art-sync/

/outputs/status-icon-generation/

# Workshop generated staging, logs and local publication identity
/workshop/.upload/
/workshop/logs/
/workshop/.workflow.lock
/workshop/mod_id*.txt
/workshop/upload-pending.txt

/workshop/github-preview.json
/workshop/github-published.json

/workshop/github-published-files.json

{
    "DARV.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-0.ancient": "Ha! A pony? A flying pony? Now that’s a rare find!",
    "DARV.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.1-0r.ancient": "Rainbow pony! See anything ya fancy this time?",
    "DARV.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0.ancient": "Even a gem this big doesn’t catch your eye?",
    "DARV.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0.next": "Reply",
    "DARV.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1.char": "Too heavy. I need something I can fly with.",
    "DARV.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1.next": "Continue",
    "DARV.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-2.ancient": "Pick a little one! Great things don’t have to be big!",
    "NEOW.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-0.ancient": "[sine]...you want... to go home.....?[/sine]",
    "NEOW.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-0.next": "Reply",
    "NEOW.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-1.char": "They’re still waiting for me.",
    "NEOW.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.1-0r.ancient": "[sine]...your wings... broken again.....[/sine]",
    "NEOW.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0.char": "One more try. I can win this time.",
    "NEOW.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0.next": "Continue",
    "NEOW.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1.ancient": "[sine]...good...[/sine]",
    "NEOW.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1.next": "Reply",
    "NEOW.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-2.char": "...They must still be waiting for me.",
    "NONUPEIPE.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-0.ancient": "A rainbow? It’s been so long since I’ve seen such beautiful colors.",
    "NONUPEIPE.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.1-0r.ancient": "Why not dress up a little? Don’t let that beautiful mane go to waste.",
    "NONUPEIPE.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0.ancient": "A girl who doesn’t like dressing up? How unusual.",
    "NONUPEIPE.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0.next": "Reply",
    "NONUPEIPE.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1.char": "Flying is my thing! Rarity’s the one who loves this stuff.",
    "NONUPEIPE.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1.next": "Continue",
    "NONUPEIPE.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-2.ancient": "She sounds like a girl with an eye for beauty! Take her a gift.",
    "OROBAS.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-0.ancient": "Hey! Pretty rainbow! Bright! Pretty!",
    "OROBAS.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.1-0r.ancient": "Hey! Flying friend! Pretty wings! I like them!",
    "OROBAS.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0.ancient": "Hey! You like flying! Let’s fly together!",
    "OROBAS.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0.next": "Reply",
    "OROBAS.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1.char": "[i](Rainbow Dash and Orobas do some flying tricks together.)[/i]",
    "OROBAS.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1.next": "Continue",
    "OROBAS.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-2.ancient": "So cool! So much fun! Look at my gifts!",
    "PAEL.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-0.ancient": "[thinky_dots]Always in the air... rest a while...[/thinky_dots]",
    "PAEL.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.1-0r.ancient": "[thinky_dots]Your wings... woke me from my dreams...[/thinky_dots]",
    "PAEL.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0.ancient": "[thinky_dots]My flesh... can help you fly farther...[/thinky_dots]",
    "PAEL.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0.next": "Answer",
    "PAEL.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1.char": "Uh... we ponies don’t eat meat.",
    "PAEL.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1.next": "Continue",
    "PAEL.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-2.ancient": "[thinky_dots]Take it... you’ll find a use for it...[/thinky_dots]",
    "TANX.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-0.ancient": "[b]HOW DID A LITTLE THING LIKE YOU GET HERE?!![/b]",
    "TANX.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-0.next": "Reply",
    "TANX.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-1.char": "I’m a fast flier.",
    "TANX.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-1.next": "Continue",
    "TANX.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-2.ancient": "[b]THEN LET’S SEE WHO’S FASTER![/b]",
    "TANX.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.1-0r.ancient": "[b]PONY! WHERE’S ALL YOUR GEAR?![/b]",
    "TANX.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0.ancient": "[b]COLORFUL PONY, FIGHT ME!![/b]",
    "TANX.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0.next": "Reply",
    "TANX.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1.char": "[i](Rainbow Dash sidesteps an incoming blow.)[/i]",
    "TANX.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1.next": "Continue",
    "TANX.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-2.ancient": "[b]FAST ENOUGH! NOW DO MORE THAN DODGE!![/b]",
    "TEZCATARA.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-0.char": "That smells so good... I miss Pinkie Pie’s cakes.",
    "TEZCATARA.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-0.next": "Continue",
    "TEZCATARA.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-1.ancient": "Come have a taste, sweetie!",
    "TEZCATARA.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.1-0r.ancient": "Ha! My little sweet tooth is back.",
    "TEZCATARA.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0.ancient": "Come down and rest, little one! Don’t be afraid of a little [jitter][b]heat[/b][/jitter]!",
    "VAKUU.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-0.char": "Who are you? You remind me of some pretty bad company.",
    "VAKUU.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-0.next": "Continue",
    "VAKUU.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-1.ancient": "Someone who can help you, little one.",
    "VAKUU.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.1-0r.ancient": "What do you crave? Power? Speed? Or freedom?",
    "VAKUU.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0.ancient": "Be loyal to me, and I can grant your [sine]every wish[/sine]...",
    "VAKUU.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0.next": "Reply",
    "VAKUU.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1.char": "[b]Go away![/b]",
    "VAKUU.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1.next": "Continue",
    "VAKUU.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-2.ancient": "Sooner or later, you’ll need me.",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-0r.ancient": "You think those wings can get you out?",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-0r.next": "Answer",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-1r.char": "Try and stop me.",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-1r.next": "Continue",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-2r.ancient": "I already have.",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.1-0r.ancient": "Back again. Still won’t admit defeat?",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.1-0r.next": "Continue",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.1-1r.char": "I’m still standing.",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.1-1r.next": "Continue",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.1-2r.ancient": "Then fall again.",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0r.ancient": "Your friends won’t come to save you.",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-0r.next": "Continue",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1r.char": "I’ll find my own way home.",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-1r.next": "Continue",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-2r.ancient": "You sound so sure.",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.0-attack": "Both",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.1-attack": "Both",
    "THE_ARCHITECT.talk.RD_MOD_CHARACTER_RAINBOW_DASH_CHARACTER.2-attack": "Both"
}
